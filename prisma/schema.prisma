// Toto-Inter — schema dati
// Vedi il piano in .claude/plans per il contesto completo delle regole di gioco.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum Competition {
  SERIE_A
  COPPA_ITALIA
  CHAMPIONS_LEAGUE
  EUROPA_LEAGUE
  FRIENDLY
  OTHER
}

enum MatchStatus {
  SCHEDULED
  LOCKED
  FINISHED
}

enum ResultSource {
  NONE
  API
  MANUAL
}

// Primo marcatore è sempre relativo all'Inter (vedi piano): PLAYER_GOAL = un
// giocatore dell'Inter segna, OWN_GOAL = autogol avversario a favore
// dell'Inter, NONE = l'Inter non segna in quella partita.
enum ScorerKind {
  PLAYER_GOAL
  OWN_GOAL
  NONE
}

enum LeagueRole {
  MEMBER
  MODERATOR
  OWNER
}

model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  passwordHash   String?
  role           Role       @default(PLAYER)
  status         UserStatus @default(INVITED)
  inviteToken    String?    @unique
  inviteExpires  DateTime?
  createdAt      DateTime   @default(now())

  // Identità pubblica del giocatore: name resta l'alias mostrato ovunque
  // (classifica, pronostici rivelati, sidebar). firstName/lastName sono
  // privati: visibili solo all'utente stesso e all'admin, mai in classifica.
  firstName      String?
  lastName       String?
  avatarUrl      String?

  predictions       Prediction[]
  matchScores       MatchScore[]
  streakStates      PlayerStreakState[]
  pushSubscriptions PushSubscription[]
  createdLeagues    League[]
  leagueMemberships LeagueMembership[]
}

// Squadra di calcio reale (oggi solo Inter). Vedi piano: Season/Match restano
// condivisi tra leghe che seguono la stessa squadra, solo MatchScore/
// PlayerStreakState (Step 3, non ancora implementato) saranno scoped per lega.
model Team {
  id          String   @id @default(uuid())
  externalRef String   @unique
  name        String
  logoUrl     String?
  active      Boolean  @default(true)

  matches Match[]
  players Player[]
  leagues League[]
}

// Gruppo di amici che segue una squadra e ha una classifica propria.
model League {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  joinCode        String?  @unique
  createdAt       DateTime @default(now())

  memberships  LeagueMembership[]
  matchScores  MatchScore[]
  streakStates PlayerStreakState[]
}

model LeagueMembership {
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  leagueId String
  league   League     @relation(fields: [leagueId], references: [id])
  role     LeagueRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  @@id([userId, leagueId])
  @@index([leagueId])
}

model Season {
  id       String   @id @default(uuid())
  label    String   @unique
  isActive Boolean  @default(false)

  matches       Match[]
  streakStates  PlayerStreakState[]
}

// Una "giornata" = una partita dell'Inter (qualunque competizione).
model Match {
  id                    String        @id @default(uuid())
  seasonId              String
  season                Season        @relation(fields: [seasonId], references: [id])
  teamId                String
  team                  Team          @relation(fields: [teamId], references: [id])
  competition           Competition
  opponent              String
  opponentLogoUrl       String?
  isHome                Boolean
  kickoffAt             DateTime
  predictionDeadlineAt  DateTime
  status                MatchStatus   @default(SCHEDULED)
  externalRef           String?       @unique
  resultSource          ResultSource  @default(NONE)

  // Risultato ufficiale, sempre sui 90 minuti.
  homeScore             Int?
  awayScore             Int?

  // Primo marcatore dell'Inter (vedi enum ScorerKind).
  firstScorerKind       ScorerKind?
  firstScorerPlayerName String?

  scoringComputedAt     DateTime?
  // Segna quando e' partito il promemoria "pronostico mancante" per questa
  // partita, cosi' il cron (che gira ogni 15-30 min) non lo rimanda piu'
  // volte durante la finestra delle 2 ore prima del fischio d'inizio.
  reminderSentAt        DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  predictions  Prediction[]
  matchScores  MatchScore[]
  syncLogs     SyncLog[]

  @@index([seasonId, kickoffAt])
  @@index([teamId])
}

model Prediction {
  id                          String      @id @default(uuid())
  matchId                     String
  match                       Match       @relation(fields: [matchId], references: [id])
  userId                      String
  user                        User        @relation(fields: [userId], references: [id])

  predictedHomeScore          Int
  predictedAwayScore          Int
  predictedScorerKind         ScorerKind
  predictedScorerPlayerName   String?

  submittedAt                 DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  @@unique([matchId, userId])
}

// Riga persistita del breakdown punti per utente/partita — mai ricalcolata
// al volo per la visualizzazione (vedi piano, sezione Motore di scoring).
model MatchScore {
  id                       String   @id @default(uuid())
  matchId                  String
  match                    Match    @relation(fields: [matchId], references: [id])
  userId                   String
  user                     User     @relation(fields: [userId], references: [id])
  leagueId                 String
  league                   League   @relation(fields: [leagueId], references: [id])

  resCorrect               Boolean
  marcatoreCorrect         Boolean

  resPoints                Decimal  @db.Decimal(10, 6)
  marcatorePoints          Decimal  @db.Decimal(10, 6)
  basePoints               Decimal  @db.Decimal(10, 6)
  comboBonus               Decimal  @db.Decimal(10, 6)

  resStreakLenAfter        Int
  marcatoreStreakLenAfter  Int
  resStreakBonusPct        Decimal  @db.Decimal(5, 4)
  marcatoreStreakBonusPct  Decimal  @db.Decimal(5, 4)
  streakBonusPoints        Decimal  @db.Decimal(10, 6)

  totalPoints              Decimal  @db.Decimal(10, 6)

  computedAt               DateTime @default(now())

  @@unique([matchId, userId, leagueId])
  @@index([leagueId])
}

// Stato corrente dello streak per utente/stagione — persistito per evitare
// di rigiocare l'intera stagione a ogni lettura (vedi piano).
model PlayerStreakState {
  userId                  String
  user                    User     @relation(fields: [userId], references: [id])
  seasonId                String
  season                  Season   @relation(fields: [seasonId], references: [id])
  leagueId                String
  league                  League   @relation(fields: [leagueId], references: [id])

  currentResStreak        Int      @default(0)
  currentMarcatoreStreak  Int      @default(0)
  lastMatchIdApplied      String?

  @@id([userId, seasonId, leagueId])
}

model SyncLog {
  id              String   @id @default(uuid())
  matchId         String?
  match           Match?   @relation(fields: [matchId], references: [id])
  provider        String
  requestSummary  String?
  responseSummary String?
  error           String?
  createdAt       DateTime @default(now())
}

// Subscription push del browser/device di un utente (Web Push API). Un
// utente può averne più di una (più device/browser); endpoint è univoco
// per costruzione (assegnato dal push service del browser).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Rosa Inter sincronizzata da API-Football (/players/squads), per popolare
// la tendina marcatore nel form pronostico/risultato. Il nome resta
// comunque salvato come stringa libera in Prediction/Match (nessuna FK):
// se un giocatore lascia la rosa, active passa a false e sparisce dalla
// tendina ma i pronostici già fatti restano intatti.
model Player {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  externalRef String
  name        String
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@unique([teamId, externalRef])
}
